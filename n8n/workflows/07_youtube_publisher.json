      "parameters": {
        "jsCode": "const loc = $input.first().json.headers.location;\nconst bin = $('Read MP4').first().binary;\nreturn [{ json: { headers: { location: loc } }, binary: bin }];"
      }
    },
    {
      "id": "1e67cb02-dffc-5d59-aa07-311791d51939",
      "name": "Build result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1980,
        320
      ],
      "parameters": {
        "jsCode": "const r = $input.first().json;\nconst job = $('Claim approved video').first().json.job_id;\nconst ok = r.statusCode >= 200 && r.statusCode < 300 && r.body && r.body.id;\nreturn [{ json: { job_id: job, success: !!ok, youtube_video_id: ok ? r.body.id : null,\n  response: (typeof r.body === 'object') ? r.body : { raw: String(r.body).slice(0, 2000) },\n  error: ok ? null : `HTTP ${r.statusCode}: ${JSON.stringify(r.body).slice(0, 1500)}` } }];"
      }
    },
