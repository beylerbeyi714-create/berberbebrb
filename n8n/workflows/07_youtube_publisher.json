      "parameters": {
        "jsCode": "const r = $input.first().json;\nconst job = $('Claim approved video').first().json.job_id;\nreturn [{ json: { job_id: job, success: false, youtube_video_id: null, response: r.body || {},\n  error: `upload session HTTP ${r.statusCode}: ${JSON.stringify(r.body).slice(0, 1500)}` } }];"
      }
    },
