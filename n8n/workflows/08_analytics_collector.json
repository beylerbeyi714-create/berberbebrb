    {
      "id": "d223ea7a-265e-5a07-8e29-8c41c2bcf97c",
      "name": "Aggregate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1560,
        420
      ],
      "parameters": {
        "jsCode": "const vids = $('Latest 20 videos').all().map(i => i.json.youtube_video_id);\nconst traffic = {}, retention = {};\n$('Analytics API: traffic sources').all().forEach((it, i) => traffic[vids[i]] = it.json);\n$input.all().forEach((it, i) => retention[vids[i]] = it.json);\nreturn [{ json: { kind: 'analytics_api', payload: { daily: $('Analytics API: per-video totals').first().json, traffic, retention } } }];"
      }
    },
