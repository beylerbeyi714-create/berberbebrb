# AI Shorts Factory — ortam değişkenleri şablonu
# scripts/setup.sh bu dosyadan .env üretir ve gizli değerleri rastgele doldurur.
# .env dosyası .gitignore içindedir; ASLA kaynak kontrolüne eklemeyin.

# ---------- Altyapı gizli değerleri (setup.sh üretir)
POSTGRES_PASSWORD=
N8N_DB_PASSWORD=
FACTORY_DB_PASSWORD=
N8N_ENCRYPTION_KEY=
FACTORY_API_TOKEN=
WORKER_API_TOKEN=
SESSION_SECRET=
N8N_WEBHOOK_TOKEN=

# ---------- Yönetim paneli girişi
PANEL_USER=admin
# bcrypt hash; düz şifre değil. Üretmek için: scripts/set_panel_password.sh
# Değer tek tırnak içinde olmalı ('$2b$12$...'), aksi halde docker compose $ işaretlerini yorumlar.
PANEL_PASSWORD_HASH=

# ---------- Alan adı / HTTPS (sunucu kurulumunda doldurun)
# Yerelde: N8N_PUBLIC_URL=http://localhost:5678, COOKIE_SECURE=false
N8N_DOMAIN=localhost
PANEL_DOMAIN=localhost
ACME_EMAIL=
N8N_PROTOCOL=http
N8N_PUBLIC_URL=http://localhost:5678
N8N_SECURE_COOKIE=false
N8N_PROXY_HOPS=0
COOKIE_SECURE=false
TIMEZONE=Europe/Istanbul

# ---------- YouTube OAuth (Google Cloud Console > Credentials > OAuth client ID, tür: Web application)
# Bu değerler yalnızca n8n kimlik bilgisini içe aktarmak için kullanılır; n8n UI'dan da girilebilir.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ---------- Yapay zekâ sağlayıcıları (kullanacaklarınızı doldurun; boş olanlar devre dışıdır)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5-mini
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash
FAL_KEY=
FAL_IMAGE_MODEL=fal-ai/flux/schnell
FAL_VIDEO_MODEL=fal-ai/kling-video/v2.1/standard/image-to-video
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2
GOOGLE_TTS_API_KEY=
GOOGLE_TTS_VOICE=tr-TR-Wavenet-E

# Tahmini fiyatları ezmek için (isteğe bağlı), örn: {"openai_image":{"per_image":0.04}}
PRICING_JSON=

# ---------- Diğer
WORKER_MAX_PARALLEL=1
BACKUP_KEEP_DAYS=14
